# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the contact, terms, privacy and refunds pages
NEXT_PUBLIC_SUPPORT_EMAIL=support@youritclass.com

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Master super admin bootstrapped by `npm run create-master`.
# Defaults: ojohcharles7@gmail.com / Admin@2026
# MASTER_ADMIN_EMAIL=
# MASTER_ADMIN_PASSWORD=
# MASTER_ADMIN_NAME=

# Local admin preview — only active while Supabase URL + anon key are unset.
# Defaults: admin@youritclass.local / admin123
# LOCAL_ADMIN_EMAIL=admin@youritclass.local
# LOCAL_ADMIN_PASSWORD=change-this
# Signs local session cookies. Falls back to SUPABASE_SERVICE_ROLE_KEY or a dev default.
# LOCAL_ADMIN_SECRET=

# Paystack test keys — https://dashboard.paystack.com/#/settings/developers
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# "paystack" (default) or "mock" for local development without keys
PAYMENTS_PROVIDER=mock
