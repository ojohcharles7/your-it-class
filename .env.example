# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the contact, terms, privacy and refunds pages
NEXT_PUBLIC_SUPPORT_EMAIL=support@learnhub.com

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Master user linked by `20261029000000_master_user.sql`.
# Defaults: ojohcharles7@gmail.com / Admin@2026
# MASTER_ADMIN_EMAIL=ojohcharles7@gmail.com

# Local admin preview — only active while Supabase URL + anon key are unset.
# Defaults: admin@learnhub.local / admin123
# LOCAL_ADMIN_EMAIL=admin@learnhub.local
# LOCAL_ADMIN_PASSWORD=change-this
# Signs local session cookies. Falls back to SUPABASE_SERVICE_ROLE_KEY or a dev default.
# LOCAL_ADMIN_SECRET=
